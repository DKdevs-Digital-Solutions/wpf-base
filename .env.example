# =========================
# APP
# =========================
PORT=3005
NODE_ENV=production
SWAGGER_BASE_URL=http://localhost:3005
API_TIMEOUT_MS=15000

# =========================
# CRM / TOKEN
# =========================
CRM_BASE_URL=https://crm-bot-stg.sigaantenado.com.br/crm/bot/api/v1
AUTH_URL=https://crm-bot-stg.sigaantenado.com.br/crm/bot/api/v1/authorization/get-token
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SWAP_CREDENTIALS=false
AUTH_TIMEOUT_MS=15000
AUTH_REFRESH_BEFORE_MS=300000
AUTH_API_KEY=
AUTH_SUBSCRIPTION_KEY=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_AUDIENCE=
AUTH_GRANT_TYPE=client_credentials

# =========================
# REDIS / FILA
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EXTERNAL_PORT=6379
BULLMQ_QUEUE_NAME=whatsapp-flows
JOB_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_TYPE=exponential
JOB_BACKOFF_DELAY_MS=5000

# =========================
# CHAVE PRIVADA
# Use apenas UMA opção:
# 1) PRIVATE_KEY com quebra de linha real
# 2) PRIVATE_KEY_BASE64 com a chave em base64
# =========================
PRIVATE_KEY=
PRIVATE_KEY_BASE64=

# =========================
# CLOUDFARE R2
# =========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_KEY_PREFIX=flows
R2_PUBLIC_BASE_URL=

# =========================
# APIs auxiliares legadas do projeto
# Preencha só se realmente usar
# =========================
CADASTRO_UNICO_API_URL=
FAMILY_CODE_VERIFICATION_API_URL=
EXTRA_PHASE_FAMILY_API_URL=
CITY_AVAILABILITY_API_URL=
EXTRA_PHASE_IBGE_API_URL=
CEP_API_URL=
CADUNICO_CHANNEL=WHATSAPP
CADUNICO_CLASSIFICATION=AGENDAMENTO
