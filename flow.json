{
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "CPF_INPUT": [
      "CPF_INPUT",
      "CONFIRMA_ENDERECO_ONE",
      "CEP_REINPUT",
      "FINISH"
    ],
    "CONTATOS": [
      "TIPO_DOCUMENTO",
      "FINISH"
    ],
    "CONFIRMA_ENDERECO_ONE": [
      "ENDERECO_COMPLETO",
      "ESCOLHER_CAMPO_ENDERECO",
      "FINISH"
    ],
    "CEP_REINPUT": [
      "CONFIRMA_ENDERECO_TWO",
      "FINISH"
    ],
    "CONFIRMA_ENDERECO_TWO": [
      "ENDERECO_COMPLETO",
      "FINISH"
    ],
    "ENDERECO_COMPLETO": [
      "CONTATOS",
      "FINISH"
    ],
    "TIPO_DOCUMENTO": [
      "DOC_FRENTE",
      "FINISH"
    ],
    "DOC_FRENTE": [
      "DOC_VERSO",
      "SELFIE_COM_DOC",
      "FINISH"
    ],
    "DOC_VERSO": [
      "SELFIE_COM_DOC",
      "FINISH"
    ],
    "SELFIE_COM_DOC": [
      "COMPROVANTE",
      "FINISH"
    ],
    "COMPROVANTE": [
      "FACHADA",
      "FINISH"
    ],
    "FACHADA": [
      "TV_LIGADA",
      "FINISH"
    ],
    "TV_LIGADA": [
      "RESUMO_FINAL",
      "FINISH"
    ],
    "RESUMO_FINAL": [
      "CONFIRMACAO_FINAL",
      "FINISH"
    ],
    "CONFIRMACAO_FINAL": [
      "FINISH"
    ],
    "ESCOLHER_CAMPO_ENDERECO": [
      "CEP_REINPUT",
      "EDITAR_CAMPO_ENDERECO",
      "FINISH"
    ],
    "EDITAR_CAMPO_ENDERECO": [
      "CONFIRMA_ENDERECO_AJUSTADO",
      "FINISH"
    ],
    "CONFIRMA_ENDERECO_AJUSTADO": [
      "ENDERECO_COMPLETO",
      "FINISH"
    ]
  },
  "screens": [
    {
      "id": "CPF_INPUT",
      "title": "CPF",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Para iniciar, informe o CPF do titular."
          },
          {
            "type": "TextBody",
            "text": "${data.cpf_feedback}"
          },
          {
            "type": "Form",
            "name": "form_cpf",
            "children": [
              {
                "type": "TextInput",
                "name": "cpf",
                "label": "CPF",
                "required": true,
                "input-type": "number",
                "helper-text": "Digite apenas números"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "cpf": "${form.cpf}",
                    "cpf_attempts": "${data.cpf_attempts}",
                    "cpf_feedback": "${data.cpf_feedback}",
                    "telefone_principal": "${data.telefone_principal}",
                    "protocolo": "${data.protocolo}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_recado": "${data.telefone_recado}",
                    "nome_contato_recado": "${data.nome_contato_recado}",
                    "cep": "${data.cep}",
                    "logradouro": "${data.logradouro}",
                    "bairro": "${data.bairro}",
                    "cidade": "${data.cidade}",
                    "uf": "${data.uf}",
                    "ibge": "${data.ibge}",
                    "numero": "${data.numero}",
                    "complemento": "${data.complemento}",
                    "ponto_referencia": "${data.ponto_referencia}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONTATOS",
      "title": "Dados de contato",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Confira e complete os dados de contato."
          },
          {
            "type": "Form",
            "name": "form_contatos",
            "children": [
              {
                "type": "TextInput",
                "name": "telefone_principal",
                "label": "Telefone principal",
                "required": true,
                "input-type": "phone",
                "init-value": "${data.telefone_principal}"
              },
              {
                "type": "TextInput",
                "name": "telefone_recado",
                "label": "Telefone de recado",
                "required": true,
                "input-type": "phone",
                "init-value": "${data.telefone_recado}"
              },
              {
                "type": "TextInput",
                "name": "nome_contato_recado",
                "label": "Nome do contato de recado",
                "required": true,
                "init-value": "${data.nome_contato_recado}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${form.telefone_principal}",
                    "telefone_recado": "${form.telefone_recado}",
                    "nome_contato_recado": "${form.nome_contato_recado}",
                    "cep": "${data.cep}",
                    "logradouro": "${data.logradouro}",
                    "bairro": "${data.bairro}",
                    "cidade": "${data.cidade}",
                    "uf": "${data.uf}",
                    "ibge": "${data.ibge}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRMA_ENDERECO_ONE",
      "title": "Confirmar endereço",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Confirme se o endereço encontrado está correto."
          },
          {
            "type": "TextBody",
            "text": "CEP: ${data.cep}\nLogradouro: ${data.logradouro}\nBairro: ${data.bairro}\nCidade: ${data.cidade}\nUF: ${data.uf}"
          },
          {
            "type": "Form",
            "name": "form_confirma_endereco_one",
            "children": [
              {
                "type": "Dropdown",
                "name": "decisao_endereco",
                "label": "O endereço está correto?",
                "required": true,
                "data-source": [
                  {
                    "id": "confirmar",
                    "title": "Sim, continuar"
                  },
                  {
                    "id": "corrigir",
                    "title": "Não, corrigir CEP"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${data.telefone_recado}",
                    "nome_contato_recado": "${data.nome_contato_recado}",
                    "cep": "${data.cep}",
                    "logradouro": "${data.logradouro}",
                    "bairro": "${data.bairro}",
                    "cidade": "${data.cidade}",
                    "uf": "${data.uf}",
                    "ibge": "${data.ibge}",
                    "decisao_endereco": "${form.decisao_endereco}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ESCOLHER_CAMPO_ENDERECO",
      "title": "Ajustar endereço",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Escolha qual campo do endereço você deseja ajustar."
