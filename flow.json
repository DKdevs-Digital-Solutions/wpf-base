{
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "CPF_INPUT": ["TELEFONE_PRINCIPAL", "FINISH"],
    "TELEFONE_PRINCIPAL": ["TELEFONE_RECADO", "FINISH"],
    "TELEFONE_RECADO": ["CEP_INPUT", "FINISH"],
    "CEP_INPUT": ["CONFIRMA_ENDERECO_CEP", "FINISH"],
    "CONFIRMA_ENDERECO_CEP": ["CEP_INPUT", "COMPLEMENTA_ENDERECO", "FINISH"],
    "COMPLEMENTA_ENDERECO": ["PONTO_REFERENCIA", "FINISH"],
    "PONTO_REFERENCIA": ["TIPO_DOCUMENTO", "FINISH"],
    "TIPO_DOCUMENTO": ["DOC_FRENTE", "FINISH"],
    "DOC_FRENTE": ["DOC_VERSO", "FINISH"],
    "DOC_VERSO": ["SELFIE_COM_DOC", "FINISH"],
    "SELFIE_COM_DOC": ["COMPROVANTE", "FINISH"],
    "COMPROVANTE": ["FACHADA", "FINISH"],
    "FACHADA": ["TV_LIGADA", "FINISH"],
    "TV_LIGADA": ["RESUMO_FINAL", "FINISH"],
    "RESUMO_FINAL": ["CONFIRMACAO_FINAL", "FINISH"],
    "CONFIRMACAO_FINAL": ["FINISH"]
  },
  "screens": [
    {
      "id": "CPF_INPUT",
      "title": "CPF",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Informe o CPF para validar elegibilidade e fase extra." },
          {
            "type": "Form",
            "name": "cpf_form",
            "children": [
              { "type": "TextInput", "name": "protocolo", "label": "Protocolo", "required": true },
              { "type": "TextInput", "name": "cpf", "label": "CPF", "required": true, "input-type": "number" },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${form.protocolo}",
                    "cpf": "${form.cpf}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TELEFONE_PRINCIPAL",
      "title": "Telefone principal",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Informe o telefone principal com DDD." },
          {
            "type": "Form",
            "name": "telefone_principal_form",
            "children": [
              { "type": "TextInput", "name": "telefone_principal", "label": "Telefone principal", "required": true, "input-type": "number" },
              {
                "type": "Footer",
                "label": "Próximo",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${form.telefone_principal}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TELEFONE_RECADO",
      "title": "Telefone para recado",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Se houver, informe um telefone para recado. Se não houver, pode enviar vazio." },
          {
            "type": "Form",
            "name": "telefone_recado_form",
            "children": [
              { "type": "TextInput", "name": "telefone_recado", "label": "Telefone para recado", "required": false, "input-type": "number" },
              {
                "type": "Footer",
                "label": "Próximo",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${form.telefone_recado}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CEP_INPUT",
      "title": "CEP",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Informe o CEP. Sempre que ele for alterado, o backend revalida viabilidade e fase extra." },
          {
            "type": "Form",
            "name": "cep_form",
            "children": [
              { "type": "TextInput", "name": "cep", "label": "CEP", "required": true, "input-type": "number" },
              {
                "type": "Footer",
                "label": "Validar CEP",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${data.telefone_recado}",
                    "cep": "${form.cep}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRMA_ENDERECO_CEP",
      "title": "Confirmar endereço",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Confira o endereço retornado pelo CEP:" },
          { "type": "TextBody", "text": "CEP: ${data.cep}\nLogradouro: ${data.logradouro}\nBairro: ${data.bairro}\nCidade: ${data.cidade}\nEstado: ${data.estado}" },
          {
            "type": "Form",
            "name": "confirmar_endereco_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "confirmar_endereco_cep",
                "label": "Os dados estão corretos?",
                "required": true,
                "data-source": [
                  { "id": "sim", "title": "Sim" },
                  { "id": "nao", "title": "Não" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${data.telefone_recado}",
                    "cep": "${data.cep}",
                    "logradouro": "${data.logradouro}",
                    "bairro": "${data.bairro}",
                    "cidade": "${data.cidade}",
                    "estado": "${data.estado}",
                    "confirmar_endereco_cep": "${form.confirmar_endereco_cep}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
