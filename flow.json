                    "id": "cep",
                    "title": "CEP"
                  },
                  {
                    "id": "logradouro",
                    "title": "Logradouro"
                  },
                  {
                    "id": "bairro",
                    "title": "Bairro"
                  },
                  {
                    "id": "cidade",
                    "title": "Cidade"
                  },
                  {
                    "id": "uf",
                    "title": "UF"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${data.telefone_recado}",
