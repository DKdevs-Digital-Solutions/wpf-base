{
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "CPF_INPUT": ["CPF_INPUT", "TELEFONE_PRINCIPAL", "FINISH"],
    "TELEFONE_PRINCIPAL": ["TELEFONE_RECADO", "FINISH"],
    "TELEFONE_RECADO": ["CEP_INPUT", "FINISH"],
    "CEP_INPUT": ["CONFIRMA_ENDERECO_CEP_1", "FINISH"],
    "CONFIRMA_ENDERECO_CEP_1": ["COMPLEMENTA_ENDERECO", "CEP_REINPUT", "FINISH"],
    "CEP_REINPUT": ["CONFIRMA_ENDERECO_CEP_2", "FINISH"],
    "CONFIRMA_ENDERECO_CEP_2": ["COMPLEMENTA_ENDERECO", "FINISH"],
    "COMPLEMENTA_ENDERECO": ["PONTO_REFERENCIA", "FINISH"],
    "PONTO_REFERENCIA": ["TIPO_DOCUMENTO", "FINISH"],
    "TIPO_DOCUMENTO": ["DOC_FRENTE", "FINISH"],
    "DOC_FRENTE": ["DOC_VERSO", "SELFIE_COM_DOC", "FINISH"],
    "DOC_VERSO": ["SELFIE_COM_DOC", "FINISH"],
    "SELFIE_COM_DOC": ["COMPROVANTE", "FINISH"],
    "COMPROVANTE": ["FACHADA", "FINISH"],
    "FACHADA": ["TV_LIGADA", "FINISH"],
    "TV_LIGADA": ["RESUMO_FINAL", "FINISH"],
    "RESUMO_FINAL": ["CONFIRMACAO_FINAL", "FINISH"],
    "CONFIRMACAO_FINAL": ["FINISH"]
  },
  "screens": [
    {
      "id": "CPF_INPUT",
      "title": "CPF",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Para iniciar, informe o CPF do titular."
          },
          {
            "type": "TextBody",
            "text": "${data.cpf_feedback}"
          },
          {
            "type": "Form",
            "name": "form_cpf",
            "children": [
              {
                "type": "TextInput",
                "name": "cpf",
                "label": "CPF",
                "required": true,
                "input-type": "number",
                "helper-text": "Digite apenas números"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${form.cpf}",
                    "cpf_attempts": "${data.cpf_attempts}",
                    "cpf_feedback": "${data.cpf_feedback}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TELEFONE_PRINCIPAL",
      "title": "Telefone principal",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Informe o telefone principal para contato." },
          {
            "type": "Form",
            "name": "form_tel_principal",
            "children": [
              { "type": "TextInput", "name": "telefone_principal", "label": "Telefone principal", "required": true, "input-type": "phone" },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${form.telefone_principal}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TELEFONE_RECADO",
      "title": "Telefone de recado",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Informe um telefone para recado e o nome do contato." },
          {
            "type": "Form",
            "name": "form_tel_recado",
            "children": [
              { "type": "TextInput", "name": "telefone_recado", "label": "Telefone de recado", "required": true, "input-type": "phone" },
              { "type": "TextInput", "name": "nome_contato_recado", "label": "Nome do contato", "required": true },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${form.telefone_recado}",
                    "nome_contato_recado": "${form.nome_contato_recado}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CEP_INPUT",
      "title": "CEP",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Digite o CEP da instalação." },
          {
            "type": "Form",
            "name": "form_cep",
            "children": [
              { "type": "TextInput", "name": "cep", "label": "CEP", "required": true, "input-type": "number" },
              {
                "type": "Footer",
                "label": "Validar CEP",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${data.telefone_recado}",
                    "nome_contato_recado": "${data.nome_contato_recado}",
                    "cep": "${form.cep}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRMA_ENDERECO_CEP_1",
      "title": "Confirmar endereço",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Confirme se o endereço encontrado está correto." },
          { "type": "TextBody", "text": "CEP: ${data.cep}\nLogradouro: ${data.logradouro}\nBairro: ${data.bairro}\nCidade: ${data.cidade}\nUF: ${data.uf}" },
          {
            "type": "Form",
            "name": "form_confirma_endereco_1",
            "children": [
              {
                "type": "Dropdown",
                "name": "decisao_endereco",
                "label": "O endereço está correto?",
                "required": true,
                "data-source": [
                  { "id": "confirmar", "title": "Sim, continuar" },
                  { "id": "corrigir", "title": "Não, corrigir CEP" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "protocolo": "${data.protocolo}",
                    "cpf": "${data.cpf}",
                    "nome": "${data.nome}",
                    "family_code": "${data.family_code}",
                    "telefone_principal": "${data.telefone_principal}",
                    "telefone_recado": "${data.telefone_recado}",
                    "nome_contato_recado": "${data.nome_contato_recado}",
                    "cep": "${data.cep}",
                    "logradouro": "${data.logradouro}",
                    "bairro": "${data.bairro}",
                    "cidade": "${data.cidade}",
                    "uf": "${data.uf}",
                    "ibge": "${data.ibge}",
                    "decisao_endereco": "${form.decisao_endereco}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CEP_REINPUT",
