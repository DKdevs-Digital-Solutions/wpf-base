                    "complemento": "${data.complemento}",
                    "ponto_referencia": "${data.ponto_referencia}",
                    "tipo_documento": "${data.tipo_documento}",
                    "foto_frente": "${data.foto_frente}",
                    "foto_verso": "${data.foto_verso}",
                    "selfie_com_doc": "${data.selfie_com_doc}",
                    "comprovante": "${data.comprovante}",
                    "fachada": "${data.fachada}",
                    "tv_ligada": "${data.tv_ligada}",
                    "confirmacao_final": "${form.confirmacao_final}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "FINISH",
      "title": "Finalizado",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Resultado do processamento" },
          { "type": "TextBody", "text": "Status: ${data.status}\nMotivo: ${data.reason}\nCódigo: ${data.reason_code}\nDetalhe: ${data.detail}" },
          {
            "type": "Footer",
            "label": "Concluir",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
