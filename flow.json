                    "cep": "${data.cep}",
                    "logradouro": "${data.logradouro}",
                    "bairro": "${data.bairro}",
                    "cidade": "${data.cidade}",
                    "uf": "${data.uf}",
                    "ibge": "${data.ibge}",
                    "numero": "${data.numero}",
                    "complemento": "${data.complemento}",
                    "ponto_referencia": "${data.ponto_referencia}",
                    "campo_endereco": "${form.campo_endereco}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "EDITAR_CAMPO_ENDERECO",
